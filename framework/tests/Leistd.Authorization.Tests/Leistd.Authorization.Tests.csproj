<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      使用关系型 Provider 而非 InMemory：只有它会真正强制唯一索引并翻译查询表达式，
      InMemory 全内存求值会让被违反的约束和不可翻译的查询静默通过。
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\components\authorization\Leistd.Authorization.Core\Leistd.Authorization.Core.csproj" />
    <ProjectReference Include="..\..\components\authorization\Leistd.Authorization.EntityFrameworkCore\Leistd.Authorization.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Leistd.TestBase\Leistd.TestBase.csproj" />
    <ProjectReference Include="..\..\components\unit-of-work\Leistd.UnitOfWork.Core\Leistd.UnitOfWork.Core.csproj" />
    <ProjectReference Include="..\..\components\unit-of-work\Leistd.UnitOfWork.EntityFrameworkCore\Leistd.UnitOfWork.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\components\multi-tenancy\Leistd.MultiTenancy.Core\Leistd.MultiTenancy.Core.csproj" />
  </ItemGroup>

</Project>
