<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 测试项目：覆盖 common.props 的打包/文档约定 -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- 读取器健壮化测试用夹具：坏 JSON / culture 声明不一致 / 正常，各自独立目录以便按 ResourcesPath 精确定位。
         磁盘文件名不含 .en. 以免被 MSBuild 当作附属(satellite)资源；用显式 LogicalName 还原读取器期望的 {path}.{culture}.json 清单名。 -->
    <EmbeddedResource Include="TestResources/Broken/messages.json" LogicalName="Leistd.Localization.Tests.TestResources.Broken.messages.en.json" />
    <EmbeddedResource Include="TestResources/Mismatch/messages.json" LogicalName="Leistd.Localization.Tests.TestResources.Mismatch.messages.en.json" />
    <EmbeddedResource Include="TestResources/Good/messages.json" LogicalName="Leistd.Localization.Tests.TestResources.Good.messages.en.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\components\localization\Leistd.Localization.Core\Leistd.Localization.Core.csproj" />
  </ItemGroup>

</Project>
