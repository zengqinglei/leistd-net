<Project Sdk="Microsoft.NET.Sdk">

  <!-- 端到端双宿主（身份服务 + 资源服务）需要 ASP.NET Core 共享框架。 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 真实管道测试宿主：直接用 TestHost（TestServer/UseTestServer/GetTestClient）。 -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\components\service-client\Leistd.ServiceClient.Core\Leistd.ServiceClient.Core.csproj" />
    <ProjectReference Include="..\..\components\service-client\Leistd.ServiceClient.OAuth\Leistd.ServiceClient.OAuth.csproj" />
    <ProjectReference Include="..\..\components\service-client\Leistd.ServiceClient.AspNetCore\Leistd.ServiceClient.AspNetCore.csproj" />
    <ProjectReference Include="..\..\components\tracing\Leistd.Tracing.AspNetCore\Leistd.Tracing.AspNetCore.csproj" />
    <ProjectReference Include="..\..\components\security\Leistd.Security.AspNetCore\Leistd.Security.AspNetCore.csproj" />
    <ProjectReference Include="..\Leistd.TestBase\Leistd.TestBase.csproj" />
  </ItemGroup>

</Project>
