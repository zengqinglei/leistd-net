<Project>

  <!-- 中央包管理（CPM）：所有第三方包版本在此统一声明，框架 csproj 仅写 version-less 的 PackageReference。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* （统一到 10.0.10，Refit 15 要求 Microsoft.Extensions.Http >= 10.0.10） -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />

    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />

    <!-- 第三方 -->
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
    <PackageVersion Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
    <PackageVersion Include="Mapster" Version="10.0.7" />
    <PackageVersion Include="Refit" Version="15.0.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="15.0.0" />
    <PackageVersion Include="Refit.Reflection" Version="15.0.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />

    <!-- 构建期（源码调试） -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />

    <!-- 测试（仅 framework/tests 下的项目使用） -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <!-- 只要断言库：共享基座不是测试项目，引 xunit 元包会经 xunit.core.props 把它标成
         IsTestProject=true，于是 dotnet test 把它当测试程序集启动并失败 -->
    <PackageVersion Include="xunit.assert" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <!-- 事务相关分支测试用（EF InMemory 不支持事务，见测试选型说明）；覆盖率收集 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- 传递钉扎：EF Core Sqlite 10.0.8 带入的 SQLitePCLRaw.lib.e_sqlite3 2.1.11 含高危原生库公告
         （GHSA-2m69-gcr7-jv3q）。仅测试工程使用（IsPackable=false，不进 NuGet 与模板），
         但没有理由让 CI 长期带着 NU1903 跑；钉到已修复版本即可，EF Core 的下限约束仍满足。 -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <!-- 官方时间替身：FakeTimeProvider 覆盖 Advance / 时区 / 夏令时，取代各测试项目手写的 ManualTimeProvider -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <!-- 官方日志替身：FakeLogger 让"日志被写出"成为可断言行为（静默降级路径需要它） -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.10.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

</Project>
