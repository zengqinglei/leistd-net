<Project>

  <!--
    Leistd 框架共享构建属性。
    由 framework/Directory.Build.props 自动导入到所有框架项目。

    版本：唯一来源是仓库根的 VERSION 文件（基准 x.y.z）。此处自动读取它作为 VersionPrefix，
    所有 Leistd.* 包同步该版本。发布预发布版（beta/nightly）时，由流水线用 dotnet pack
    的 -p:Version=... 追加后缀覆盖，见 .github/workflows/release-*.yml。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</VersionPrefix>
    <!--
      Release 视告警为错误：CI 只构建 Release，而 check-all.ps1 不编译，
      构建告警此前没有任何一道闸门看得见（CS0419 就是这么留到评审才被发现的）。
      Debug 保持宽松，本地迭代不被未用变量之类的临时告警打断。
    -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      让 framework/.editorconfig 里的 IDE 规则在构建期生效（默认只在 IDE 内提示）。
      目前唯一被提到 error 的是 IDE0130「命名空间与目录一致」——它是"目录即命名空间"
      这条约定的机械闸门，见 framework/.editorconfig 的说明。
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- NuGet 包元数据 -->
  <PropertyGroup>
    <Authors>zengql</Authors>
    <Product>Leistd Framework</Product>
    <PackageProjectUrl>https://github.com/zengqinglei/leistd-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zengqinglei/leistd-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>leistd ddd aspnetcore framework dotnet</PackageTags>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS0436: 类型冲突（生成文档时容忍）。
         CS1591（公共可见成员缺 XML 注释）刻意**不**放进 NoWarn：随包 .xml 是消费者与 AI
         唯一能看到的契约来源，缺注释应当在构建时就红。编译器的「publicly visible」判据比
         任何正则都准，因此这道闸门由它承担，scripts/check-doc-comment-shape.py 只管形态。 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- 默认所有框架项目可打包，纯内部项目可在自身 csproj 覆盖为 false -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    源码调试：PDB 内嵌进主包 + Source Link + 确定性构建。
    - PDB 随主 .nupkg 分发（不产独立 snupkg），装包即有符号；
    - Source Link 让调试器按 commit 从 GitHub 远程按需拉取源码，开发者无需手动 clone 框架仓。
    前提：框架代码须已推送到 RepositoryUrl 指向的 GitHub 远程，调试器方能拉到对应源码。
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- 把 .pdb 一并打进主 .nupkg 的构建输出目录 -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 每个项目的 NuGet 自述文件（指向 framework 根的 NuGet.md） -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)NuGet.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    组件用法文档随包分发（P5 / 引用链路 L4）。
    项目目录布局：
    - 通用组件：components/<家族>/<项目>/  → 项目目录的父目录名即家族名（如 lock），文档 docs/components/<家族>.md。
    - DDD 基座：ddd-struct/<项目>/         → 父目录名为 ddd-struct，统一文档 docs/ddd-struct/ddd-struct.md。
    统一：_LeistdParentDir = 项目目录的父目录名。
      component 分支打包 docs/components/<父目录名>.md（仅真实家族存在，Exists 保护）；
      ddd-struct 分支在父目录名为 ddd-struct 时打包统一文档。
    同家族多个包都内置该家族文档（用户装任一包即可就地拿到用法），打进包内 docs/ 目录。
  -->
  <PropertyGroup>
    <_LeistdParentDir>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))</_LeistdParentDir>
    <_LeistdComponentDocPath>$(MSBuildThisFileDirectory)docs\components\$(_LeistdParentDir).md</_LeistdComponentDocPath>
    <_LeistdDddDocPath>$(MSBuildThisFileDirectory)docs\ddd-struct\ddd-struct.md</_LeistdDddDocPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(_LeistdComponentDocPath)" Pack="true" PackagePath="docs\" Visible="false"
          Condition="Exists('$(_LeistdComponentDocPath)')" />
    <None Include="$(_LeistdDddDocPath)" Pack="true" PackagePath="docs\" Visible="false"
          Condition="'$(_LeistdParentDir)' == 'ddd-struct' And Exists('$(_LeistdDddDocPath)')" />
  </ItemGroup>

</Project>
