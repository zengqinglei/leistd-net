# docker-compose.yml 需要的部署变量清单。复制为 deploy/.env（已被 Git 忽略）后逐项填写：
#   cp deploy/.env.example deploy/.env
# 这里只列变量名与用途，不放任何可用的值；真实值来自密钥管理系统或 CI 的 secret，不进仓库。
# 必填项在 compose 里以 ${VAR:?} 引用，漏填时 compose 会带着变量名直接失败。

# 数据库：迁移作业用 postgres（DDL）身份，backend 用只有 DML 权限的应用身份
MIGRATOR_DB_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
#if (LocalIdentity)

# 超级管理员口令（至少 12 个字符）：库里还没有超级管理员时用于创建，首次部署必填，已有管理员后可以不再提供
DEFAULT_ADMIN_PASSWORD=
#endif
#if (IncludeNotifications && LocalIdentity)

# 可选：站点对外地址，通知邮件据此把站内链接拼成绝对地址（前端开启哈希路由时以 /# 结尾）
PUBLIC_BASE_URL=
#endif
#if (OpenIddictServer)

# 令牌签名与加密证书（PKCS#12 文件路径，相对 deploy/ 目录）及其口令
OAUTH_SIGNING_CERTIFICATE_FILE=
OAUTH_SIGNING_CERTIFICATE_PASSWORD=
OAUTH_ENCRYPTION_CERTIFICATE_FILE=
OAUTH_ENCRYPTION_CERTIFICATE_PASSWORD=
#endif
#if (RemoteTokenAuth)

# 身份服务：令牌签发方与回源地址。本服务的受众取 appsettings.json 的 Authentication:Audience，
# 并须在身份服务的 OAuth:ApiResources 里登记同一个值
IDENTITY_ISSUER=
IDENTITY_AUTHORITY=
IDENTITY_BASE_ADDRESS=
# 运行时与迁移作业使用不同的机器身份：运行时只查路由，迁移只读迁移元数据
RESOURCE_CLIENT_ID=
RESOURCE_CLIENT_SECRET=
MIGRATOR_CLIENT_ID=
MIGRATOR_CLIENT_SECRET=
# 可选：租户路由缓存生存期，缺省 00:10:00
# TENANT_ROUTE_CACHE_TTL=00:10:00
#endif

# 可选：镜像名。默认本地标签（companyname-projectname:latest、companyname-projectname-migrator:latest），
# 发布到镜像仓库时填完整名称，如 registry.example.com/team/companyname-projectname:1.0.0
# BACKEND_IMAGE=
# MIGRATOR_IMAGE=
# 可选：容器进程的本地时区，缺省 UTC
# TZ=UTC
