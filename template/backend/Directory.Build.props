<Project>

  <!--
    LeistdFrameworkVersion：项目引用的 Leistd.* 框架包版本，Directory.Packages.props 统一取用。
    升级框架只改这一处，随后按框架升级说明处理破坏性变更。
  -->
  <PropertyGroup>
    <LeistdFrameworkVersion>1.2.2</LeistdFrameworkVersion>
  </PropertyGroup>

  <!--
    代码风格在构建期检查，规则见 .editorconfig。
    IDE0005（未使用的 using）只有生成 XML 文档时才在构建期报出，因此开启 GenerateDocumentationFile；
    XML 注释只写职责和非显然契约：不要求公开成员都有注释（CS1591），也不要求逐个参数写 param（CS1573）；
    cref 无法解析、注释放错位置等其余文档警告照常报出。XML 文件不随发布输出。
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!--
    NuGet 安全公告（NU1901–NU1904）在 verify 的告警即错误下仍只告警（NuGet 官方建议的写法）：公告随 nuget.org 收录而变，
    与本次改动无关，升为错误会让所有流水线同时变红。high/critical 由 CI 的后端依赖审计把关
    （scripts/audit-backend-dependencies.ps1，定时与包版本变化时运行），处理方式见 docs/standards/tech-stack.md §3。
  -->
  <PropertyGroup>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
