<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 开发环境的机密（管理员密码、本机数据库口令）存 user-secrets；与 DbMigrator 共用同一份，设置一次两边都能读 -->
    <UserSecretsId>7f3c2a1e-4b5d-4e6f-9a8b-0c1d2e3f4a5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试程序集可见内部类型。启动门禁的确认逻辑（解析发现文档、比对 issuer、取 JWKS）
         必须被真实执行过：只测布尔门禁的前后状态，等于没测"什么情况下才算确认通过"，
         而那正是这道门禁的全部内容。 -->
    <InternalsVisibleTo Include="CompanyName.ProjectName.IntegrationTests" />
  </ItemGroup>

<!--#if (IncludeLocalization)-->
  <ItemGroup>
    <!-- 本地化资源随程序集嵌入（业务文案键，按 culture 查表） -->
    <EmbeddedResource Include="Resources\*.json" />
  </ItemGroup>
<!--#endif-->


  <ItemGroup>
<!--#if (ServiceUserContextEnabled)-->
    <PackageReference Include="OpenIddict.AspNetCore" />
<!--#endif-->
<!--#if (!LocalIdentity)-->
    <PackageReference Include="OpenIddict.Validation.SystemNetHttp" />
<!--#endif-->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 业务项目内部引用 -->
  <ItemGroup>
    <ProjectReference Include="..\CompanyName.ProjectName.Application\CompanyName.ProjectName.Application.csproj" />
    <ProjectReference Include="..\CompanyName.ProjectName.Infrastructure\CompanyName.ProjectName.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Leistd 框架引用 -->
  <ItemGroup>
    <PackageReference Include="Leistd.Data" />
    <PackageReference Include="Leistd.ExceptionHandling.AspNetCore" />
    <PackageReference Include="Leistd.ServiceClient.Core" />
<!--#if (IncludeLocalization)-->
    <PackageReference Include="Leistd.Localization.AspNetCore" />
<!--#endif-->
    <PackageReference Include="Leistd.DependencyInjection.DynamicProxy" />
    <PackageReference Include="Leistd.Authorization.AspNetCore" />
    <!-- 授权阶段被拒的补记：注解 + HttpContext 扩展，在所有服务形态下都需要 -->
    <PackageReference Include="Leistd.OperationRecords.AspNetCore" />
    <PackageReference Include="Leistd.MultiTenancy.AspNetCore" />
    <PackageReference Include="Leistd.Security.AspNetCore" />
    <PackageReference Include="Leistd.Tracing.AspNetCore" />
    <PackageReference Include="Leistd.Tracing.HttpClient" />
    <!-- 周期任务调度与进程内队列；组件自带的维护任务（归档、通知保留期、宿主级设置刷新）靠它跑 -->
    <PackageReference Include="Leistd.BackgroundJobs.InProcess" />
    <PackageReference Include="Leistd.Settings.AspNetCore" />
    <!-- 宿主级设置经配置源覆盖部署配置（日志级别、发信参数、审计保留期） -->
    <PackageReference Include="Leistd.Settings.Hosting" />
<!--#if (ServiceUserContextEnabled)-->
    <!-- 服务间用户/租户上下文的受信恢复是**消费侧**能力：Identity 与 Resource 都要，
         Standalone 没有机器令牌这回事。条件必须与 Program.cs 的 using 和调用点一致 -->
    <PackageReference Include="Leistd.ServiceClient.AspNetCore" />
<!--#endif-->
<!--#if (IncludeNotifications)-->
    <PackageReference Include="Leistd.Notifications.Core" />
    <PackageReference Include="Leistd.Notifications.AspNetCore" />
    <PackageReference Include="Leistd.Notifications.AspNetCore.SignalR" />
    <PackageReference Include="Leistd.RealTime.AspNetCore.SignalR" />
<!--#if (LocalIdentity)-->
    <!-- 通知偏好（按收件人的用户级设置投递）与邮件渠道：只有持有本地用户的形态才有 -->
    <PackageReference Include="Leistd.Notifications.Settings" />
    <PackageReference Include="Leistd.Notifications.Email" />
<!--#endif-->
<!--#endif-->
  </ItemGroup>

</Project>
