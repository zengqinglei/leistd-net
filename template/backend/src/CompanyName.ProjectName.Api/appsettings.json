{
  "Authentication": {
    "Issuer": "https://identity.example.com/",
    "Audience": "companyname-projectname"
  },
  "ConnectionStrings": {
    "Default": ""
  },
//#if (!LocalIdentity)
  // 租户路由缓存生存期。改租户数据落点时的排空等待 = max(Access Token 有效期, 本值)，
  // 两者彼此独立。启动期校验：缺省或超过 1 小时都拒绝启动
  "TenantRouting": {
    "CacheLifetime": "00:10:00"
  },
//#endif
  "OAuth": {
    "CookieExpireDays": 7,
    "UseDevelopmentCertificates": true,
    "DisableHttpsRequirement": false,
    "Resource": "companyname-projectname-api"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "//": "部署在 ingress/网关后面时填入代理网段或地址，否则转发头会被忽略（仅信任环回）",
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowAnyLocalhost": false,
    "AllowedOrigins": []
  },
//#if (LocalIdentity)
  // 验证码摘要密钥（Base64，至少 32 字节）。必须由部署注入且跨实例跨重启稳定——
  // 不稳定会让验证码在签发它的实例之外校验不过。缺失即启动失败，没有回落密钥
  "VerificationCodes": {
    "Key": ""
  },
//#endif
  "DefaultAdmin": {
    // 首次启动创建的超级管理员。Password 必须由部署注入（环境变量 / user-secrets），
    // 缺失、空值或等于曾公开发布过的示例值都会在启动期被拒绝。
    // 基础配置里刻意不放可用密码：开源模板里的默认密码等于公开凭据
    "Username": "admin",
    "Password": "",
    "Email": "admin@companyname-projectname.com",
    "DisplayName": "System Administrator"
  },
  "UserRegistration": {
    "EnableEmailVerification": false,
    "CaptchaExpiryMinutes": 5,
    "EmailCodeExpiryMinutes": 5,
    "EmailCodeSendIntervalSeconds": 60,
    "EmailCodeMaxAttempts": 5
  },
  "Leistd": {
    "GlobalException": {
      "Enabled": true,
      "ExcludePatterns": []
    },
//#if (LocalIdentity)
    // 发信配置。默认指向本机邮件捕获器（docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit），
    // 因此开发期能在 http://localhost:8025 看到真实投出去的信，而不是一封都没发。
    // 生产必须覆盖 Host/Port/EnableSsl/DefaultFromAddress；Username/Password 属于凭据，
    // 不写在这里，由环境变量或 user-secrets 注入。四项在启动期校验，配错则起不来。
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "EnableSsl": false,
        "DefaultFromAddress": "noreply@companyname-projectname.local",
        "DefaultFromName": "CompanyName ProjectName"
      }
    },
//#endif
    "ServiceClients": {
      "Identity": {
        "BaseAddress": "https://identity.example.com",
        "Scope": "tenant-routing.read"
      }
    }
  }
}
