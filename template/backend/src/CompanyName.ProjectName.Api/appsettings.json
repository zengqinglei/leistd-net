{
//#if (RemoteTokenAuth)
  "Authentication": {
    // 必填：签发令牌的 Identity 服务地址（绝对 http(s) URI），缺失时启动失败
    "Issuer": "",
//#if (ResourceBrowserSession)
    // 必填：在 Identity 登记的 web/confidential 客户端；机密值由后端配置源提供
    "ClientId": "",
    "ClientSecret": "",
//#endif
    // 本服务 API 的资源标识：只接受受众是它的访问令牌。在 Identity 的 OAuth:ApiResources 里登记同一个值，
    // 后端依赖方申请的 API scope 映射到此受众；不同名时配置 Authentication:Scope
    "Audience": "companyname-projectname-api"
  },
//#endif
  "ConnectionStrings": {
//#if (IncludeDistributedEvents)
    "RabbitMQ": "",
//#endif
    "Default": ""
  },
//#if (!RemoteTokenAuth)
  "DisplayDefaults": {
    // 组织与个人都没设置时的界面默认值，所有组织共用；空为跟随设备（浏览器的语言与时区）。
    // 启动期读取：修改后需重启各实例，并保持各实例一致
//#if (IncludeLocalization)
    // 界面语言：en 或 zh-CN
    "Language": "",
//#endif
    // 展示时区：IANA 名，如 Asia/Tokyo
    "TimeZone": ""
  },
//#endif
//#if (OpenIddictServer)
  "OAuth": {
    // 本服务 API 的资源标识，同名登记为 scope
    "Resource": "companyname-projectname-api",
    // 由本服务签发令牌的下游 API：每项以 Name 为资源标识登记一个服务级 scope，申请它签发的访问令牌受众即 Name，
    // 下游服务把自己的 Authentication:Audience 设为同一个值。Scope 与 OwnerClientId 可单独配置，不配时取 Name
    "ApiResources": []
  },
//#endif
  "Logging": {
    "LogLevel": {
      // 全局最小级别，可在系统设置的「运维」面板覆盖；下面按类别列出的覆盖不受该设置影响
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // 关掉 Hosting 的请求作用域（RequestPath/RequestId）与请求开始、结束日志：与请求完成日志重复，还会把原始路径带进每一条日志。
      // 代价是该类别的日志全部关闭，其中包括 Web 宿主自己的启动异常日志；通用宿主仍以 Error 记录启动失败，异常照常抛出并由运行时输出。
      // 启动完成前 OTLP 本来也不发送。
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      // 请求完成日志（内置 HTTP 日志）：不单独放开时会被上一行滤掉
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
//#if (!IncludeOperationRecords)
      "Leistd.OperationRecords": "Information",
//#endif
//#if (OpenIddictServer || RemoteTokenAuth)
      // OpenIddict 的 Information 事件逐个记录协议请求，与 Microsoft.AspNetCore 一样按框架类别降到 Warning。
      // 排障时临时调回 Information：参数值已由 OpenIddict 替换成 [redacted]，但渲染后的消息带参数名（如 client_secret）
      "OpenIddict": "Warning",
//#endif
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      // 显式写出 simple：名称为空时控制台提供程序走旧选项兼容分支，旧的 IncludeScopes=false 会盖掉下面的 true。
      // 需要结构化输出时只把它覆盖为 json，两种格式共用 FormatterOptions
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "//": "部署在 ingress/网关后面时填入代理网段或地址，否则转发头会被忽略（仅信任环回）",
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    // 默认为空：浏览器页面与 API 同源（本机开发经前端代理转发），不靠 CORS 放行。
    // 只为显式需要直接调用本 API 的其他源列出地址；它不参与浏览器认证，跨源部署前端不受支持
    "AllowedOrigins": []
  }
//#if (LocalIdentity || Email || IncludeOperationRecords || RemoteTokenAuth)
  ,
//#endif
//#if (LocalIdentity)
  "DefaultAdmin": {
    // 库里还没有超级管理员时按此创建。Password 由部署注入（环境变量 / user-secrets），
    // 只在创建那一刻校验：缺失或不满足密码策略（至少 12 个字符）即启动失败；已有管理员时不需要。
    // 基础配置里刻意不放可用密码：开源模板里的默认密码等于公开凭据
    "Password": "",
    "DisplayName": "System Administrator"
  },
  // 通行密钥（WebAuthn）的依赖方：站点的可注册域名（RelyingPartyId，不含协议与端口）与允许的页面来源。
  // 部署决策点，都留空时通行密钥不可用、照常启动；登记过的通行密钥绑定 RP ID，部署后不要再改
  "Passkeys": {
    "RelyingPartyId": "",
    "Origins": []
  }
//#if (Email || IncludeOperationRecords || RemoteTokenAuth)
  ,
//#endif
//#endif
//#if (Email || IncludeOperationRecords || RemoteTokenAuth)
  "Leistd": {
//#if (Email)
    "Security": {
      // Base64、至少32字节，所有实例和重启使用同一密钥。
      "VerificationCodes": { "Key": "" }
    },
//#endif
    // 分布式锁的键前缀默认是应用名（"companyname-projectname:"），登记在基础设施的缓存与锁注册里，API 与迁移、恢复作业共用。
    // 多个应用共用一个 Redis 时各自的前缀必须不同；需要追加环境时由部署侧设置 Leistd:Lock:Redis:KeyPrefix，
    // 并且 API 与所有迁移、恢复作业必须同值，否则锁键不同、彼此不互斥。前缀不会自动补分隔符。
//#if (IncludeOperationRecords)
    "OperationRecords": {
      // 保留期部署基线：代码默认为空，启用归档时必填（30–3650 天）。
      // 默认关闭归档；宿主管理员可在系统设置的「审计」面板覆盖，下一轮归档即生效。
      "Retention": {
        "RetentionDays": 365
      }
    }
//#if (Email || RemoteTokenAuth)
    ,
//#endif
//#endif
//#if (IncludeNotifications && Email)
    "Notifications": {
      "Email": {
        // 站点对外地址：通知邮件把站内链接（如安全提醒指向的安全设置页）拼成可点开的绝对地址。
        // 留空则邮件不附站内链接；前端开启哈希路由（useHash）时以 /# 结尾，如 https://app.example.com/#
        "PublicBaseUrl": ""
      }
    },
//#endif
//#if (Email)
    // 发信配置。默认指向本机邮件捕获器（docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit），
    // 因此开发期能在 http://localhost:8025 看到真实投出去的信，而不是一封都没发。
    // 生产必须覆盖 Host/Port/DefaultFromAddress；TLS 沿用组件默认 true，开发档为本机 Mailpit 关闭。
    // Username/Password 属于凭据，由环境变量或 user-secrets 注入；配置在启动期校验。
    // 这里是部署基线：宿主管理员可在「系统设置 → 邮件发送」里运行期覆盖，清除覆盖值即回到这里。
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "DefaultFromAddress": "noreply@companyname-projectname.local",
        "DefaultFromName": "CompanyName.ProjectName"
      }
    }
//#endif
//#if (RemoteTokenAuth)
//#if (Email)
    ,
//#endif
    "ServiceClients": {
      "Identity": {
//#if (IncludeMultiTenancy)
        // Resource 形态必填：回源租户连接配置与账户偏好的 Identity 服务地址，缺失时启动失败
        "BaseAddress": "",
        // 机器身份：查租户路由、按用户读账户偏好；不给迁移元数据 scope
        "Scope": "tenant-routing.read account-preferences.read",
//#else
        // Resource 形态必填：读写账户偏好的 Identity 服务地址
        "BaseAddress": "",
        // 机器身份：按用户读账户偏好（给收件人产出文本时没有用户令牌）
        "Scope": "account-preferences.read",
//#endif
        // 代表用户本人写账户偏好：Audience 填 Identity 的 OAuth:Resource，Scope 填 Identity 为它登记的服务级 scope；
        // Identity 须为本服务的客户端开通 Token Exchange 授予（见 docs/standards/service-invocation.md）
        "TokenExchange": {
          "Audience": "",
          "Scope": ""
        }
      }
    }
//#endif
  }
//#endif
}
