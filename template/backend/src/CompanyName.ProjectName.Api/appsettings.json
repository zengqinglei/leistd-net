{
  "ConnectionStrings": {
    "Default": ""
  },
  "OAuth": {
    "CookieExpireDays": 7,
    "UseDevelopmentCertificates": true,
    "DisableHttpsRequirement": false,
    "Resource": "companyname-projectname-api"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "//": "部署在 ingress/网关后面时填入代理网段或地址，否则转发头会被忽略（仅信任环回）",
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowAnyLocalhost": false,
    "AllowedOrigins": []
  },
  "DefaultAdmin": {
    "Username": "admin",
    "Password": "Admin@123456",
    "Email": "admin@companyname-projectname.com",
    "DisplayName": "System Administrator"
  },
  "Encryption": {
    "Key": "tYpx0UYG9OPSBeeIrKFucrJ0oni3SFOPjZNFjsXjItM="
  },
  "UserRegistration": {
    "EnableEmailVerification": false,
    "CaptchaExpiryMinutes": 5,
    "EmailCodeExpiryMinutes": 5,
    "EmailCodeSendIntervalSeconds": 60
  },
  "Leistd": {
    "GlobalException": {
      "Enable": true,
      "ExcludePathPatterns": []
    }
  }
}
