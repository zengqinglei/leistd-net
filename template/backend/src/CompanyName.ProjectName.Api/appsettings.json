{
  "Authentication": {
    "Issuer": "https://identity.example.com/",
    "Audience": "companyname-projectname"
  },
  "ConnectionStrings": {
    "Default": ""
  },
//#if (!LocalIdentity)
  // 租户路由缓存生存期。改租户数据落点时的排空等待 = max(Access Token 有效期, 本值)，
  // 两者彼此独立。启动期校验：缺省或超过 1 小时都拒绝启动
  "TenantRouting": {
    "CacheLifetime": "00:10:00"
  },
//#endif
  "OAuth": {
    "CookieExpireDays": 7,
    // 令牌签名与加密证书。默认必须显式提供（PKCS#12 文件路径 + 口令，口令属于凭据，由部署注入）；
    // 开发证书只在 appsettings.Development.json 里打开，缺证书且未打开时启动失败
    "UseDevelopmentCertificates": false,
    "DisableHttpsRequirement": false,
    "Resource": "companyname-projectname-api"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "//": "部署在 ingress/网关后面时填入代理网段或地址，否则转发头会被忽略（仅信任环回）",
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowAnyLocalhost": false,
    "AllowedOrigins": []
  },
//#if (LocalIdentity)
  // 验证码摘要密钥（Base64，至少 32 字节）。必须由部署注入且跨实例跨重启稳定——
  // 不稳定会让验证码在签发它的实例之外校验不过。缺失即启动失败，没有回落密钥
  "VerificationCodes": {
    "Key": ""
  },
//#endif
  "DefaultAdmin": {
    // 首次启动创建的超级管理员。Password 必须由部署注入（环境变量 / user-secrets），
    // 缺失、空值或不满足密码策略（至少 12 个字符）都会在启动期被拒绝。
    // 基础配置里刻意不放可用密码：开源模板里的默认密码等于公开凭据
    "Username": "admin",
    "Password": "",
    "Email": "admin@companyname-projectname.com",
    "DisplayName": "System Administrator"
  },
  "UserRegistration": {
    "EnableEmailVerification": false,
    "CaptchaExpiryMinutes": 5,
    "EmailCodeExpiryMinutes": 5,
    "EmailCodeSendIntervalSeconds": 60,
    "EmailCodeMaxAttempts": 5
  },
  "Leistd": {
    // 分布式锁的键前缀。**多个应用共用一个 Redis 实例时必须给**：没有前缀时锁键就是业务键，
    // 而组件的周期任务用的是固定作业名（operation-records.archive、notifications.retention），
    // 两个不相关的服务会互相抢同一把锁——抢不到的那个当轮直接跳过，两边日志各自都正常。
    // 建议取"应用名 + 环境"，环境部分由部署侧覆盖；前缀不会自动补分隔符。
    "Lock": {
      "Redis": {
        "KeyPrefix": "companyname-projectname:"
      }
    },
    "GlobalException": {
      "Enabled": true
    },
    "OperationRecords": {
      // 操作记录到期归档。**默认关闭**：审计表只增不减是安全的默认值，
      // 一个默认就会动审计数据的开关，会让不知情的部署某天夜里悄悄丢掉合规所需的历史。
      // 启用后，早于保留期的记录会在每天 DailyRunHourUtc 点被**搬进 OperationRecordArchives 表**
      // （不是删除——数据仍在库里，只是不再参与日常查询）。
      // RetentionDays 取 30–3650；DailyRunHourUtc 按 UTC，要对齐当地凌晨需由部署侧自行换算。
      // Enabled 与 RetentionDays 是基线：宿主管理员可在系统设置的「审计」面板覆盖，下一轮归档即生效
      "Retention": {
        "Enabled": false,
        "RetentionDays": 365,
        "DailyRunHourUtc": 18,
        "BatchSize": 500
      }
    },
//#if (IncludeNotifications)
    "Notifications": {
      // 旧通知的保留期清理，默认开启：已读保留 90 天、未读保留 365 天（未读不得短于已读）
      "Retention": {
        "Enabled": true,
        "ReadRetentionDays": 90,
        "UnreadRetentionDays": 365,
        "DailyRunHourUtc": 19,
        "BatchSize": 500
      }
    },
//#endif
    "Settings": {
      // 别的实例上改的宿主级设置（日志级别、发信参数、审计保留期）多久在本实例生效
      "Hosting": {
        "RefreshInterval": "00:00:30"
      }
    },
//#if (LocalIdentity)
    // 发信配置。默认指向本机邮件捕获器（docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit），
    // 因此开发期能在 http://localhost:8025 看到真实投出去的信，而不是一封都没发。
    // 生产必须覆盖 Host/Port/EnableSsl/DefaultFromAddress；Username/Password 属于凭据，
    // 不写在这里，由环境变量或 user-secrets 注入。四项在启动期校验，配错则起不来。
    // 这里是部署基线：宿主管理员可在「系统设置 → 邮件发送」里运行期覆盖，清除覆盖值即回到这里。
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "EnableSsl": false,
        "DefaultFromAddress": "noreply@companyname-projectname.local",
        "DefaultFromName": "CompanyName.ProjectName"
      }
    },
//#endif
    "ServiceClients": {
      "Identity": {
        "BaseAddress": "https://identity.example.com",
        "Scope": "tenant-routing.read"
      }
    }
  }
}
