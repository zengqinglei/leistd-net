{
  // 开发环境的非机密配置，随仓库提交，所有开发者共用。机密（管理员密码、本机数据库口令、验证码密钥）
  // 与只属于某台机器的覆盖一律放 user-secrets（开发环境自动加载、不进仓库），不写在这里。
//#if (OpenIddictServer)
  "OAuth": {
    // 开发证书只在本机使用：每台机器各生成一份，不能用于任何共享环境
    "UseDevelopmentCertificates": true
  },
//#endif
  "Database": {
    // 未配置 ConnectionStrings:Default 时使用内存库，克隆后即可启动；
    // 用 user-secrets 配上连接串就自动改用真实数据库，不必改这里
    "InMemoryName": "companyname-projectname-dev"
  }
}
