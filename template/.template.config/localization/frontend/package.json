{
  "name": "companyname-projectname-web",
  "version": "1.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "transloco-optimize dist/companyname-projectname-web/browser/i18n",
    "test": "npm run test:config && ng test",
    "test:config": "node --test scripts/*.test.mjs",
    //#if (LocalIdentity)
    "e2e": "playwright test",
    //#endif
    "lint": "npm run lint:ts && npm run lint:style && npm run format",
    "lint:ts": "eslint --cache --cache-strategy content --cache-location .cache/lint/eslint --max-warnings=0 \"src/**/*.{ts,html}\" \"_mock/**/*.ts\"",
    "lint:style": "stylelint --cache --cache-strategy content --cache-location .cache/lint/stylelint \"src/**/*.css\"",
    "lint:fix": "npm run lint:ts:fix && npm run lint:style:fix && npm run format:fix",
    "lint:ts:fix": "eslint --fix --max-warnings=0 \"src/**/*.{ts,html}\" \"_mock/**/*.ts\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.css\"",
    "format": "prettier --check . --cache --cache-strategy content --cache-location .cache/lint/prettier",
    "format:fix": "prettier --write .",
    "postinstall": "node -e \"require('node:fs').rmSync('.cache/lint', { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@jsverse/transloco": "~8.4.0",
    //#if (IncludeNotifications || IncludeRealTime)
    "@microsoft/signalr": "^10.0.11",
    //#endif
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@spartan-ng/brain": "1.10.0",
    "@tanstack/angular-charts": "1.5.0",
    "@tanstack/angular-table": "9.3.2",
    "@tanstack/charts": "1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    //#if (LocalIdentity)
    "qrcode": "^1.5.4",
    //#endif
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-optimize": "^8.4.0",
    "@playwright/test": "^1.65.1",
    "@spartan-ng/cli": "1.10.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testcontainers/postgresql": "^12.2.1",
    //#if (LocalIdentity)
    "@types/qrcode": "^1.5.6",
    //#endif
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.1.0",
    "stylelint-order": "^8.1.3",
    "tailwindcss": "^4.3.5",
    //#if (LocalIdentity && IncludeDistributedEvents)
    "testcontainers": "^12.2.1",
    //#endif
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@oxc-parser/binding-wasm32-wasi@0.158.0": {
      "@napi-rs/wasm-runtime": "1.2.5"
    }
  },
  "lint-staged": {
    "{src,_mock}/**/*.{ts,html}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "src/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{js,json,md,mjs,yaml,yml}": "prettier --write"
  }
}
