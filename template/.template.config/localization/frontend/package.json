{
  "name": "companyname-projectname-web",
  "version": "1.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c debug",
    "build": "ng build",
    "test": "ng test",
    "lint": "npm run lint:ts && npm run lint:style && npm run format",
    "lint:ts": "eslint --max-warnings=0 \"src/**/*.{ts,html}\" \"_mock/**/*.ts\"",
    "lint:style": "stylelint \"src/**/*.css\"",
    "lint:fix": "npm run lint:ts:fix && npm run lint:style:fix && npm run format:fix",
    "lint:ts:fix": "eslint --fix --max-warnings=0 \"src/**/*.{ts,html}\" \"_mock/**/*.ts\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.css\"",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/cdk": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@fontsource/geist": "^5.2.9",
    "@jsverse/transloco": "^8.4.0",
    "@microsoft/signalr": "^10.0.0",
    "@ng-icons/core": "34.0.0",
    "@ng-icons/lucide": "34.0.0",
    "@spartan-ng/brain": "1.3.4",
    "@tanstack/angular-table": "8.21.4",
    "angular-auth-oidc-client": "22.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markdown-it": "^14.2.0",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/jasmine": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@eslint/js": "^9.39.5",
    "@spartan-ng/cli": "1.3.4",
    "angular-eslint": "^22.1.0",
    "debug": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jasmine-core": "~6.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "stylelint": "^17.3.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^7.0.1",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "{src,_mock}/**/*.{ts,html}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "src/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{js,json,md,mjs,yaml,yml}": "prettier --write"
  }
}
