{
  "$schema": "https://json.schemastore.org/template.json",
  "author": "Fullstack Template",
  "classifications": [
    "Web",
    "Fullstack",
    "Angular",
    ".NET",
    "DDD"
  ],
  "identity": "FullstackApp.Template.CSharp",
  "name": "Fullstack App (.NET + Angular)",
  "description": ".NET 10 + Angular 22 全栈项目模板，DDD 四层架构，支持 Identity、Standalone 和 Resource 三种服务形态以及可选通知、外部登录和本地化",
  "shortName": "fullstack-app",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CompanyName.ProjectName",
  "guids": [
    "7f3c2a1e-4b5d-4e6f-9a8b-0c1d2e3f4a5b"
  ],
  "SpecialCustomOperations": {
    "**/.env.example": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "#if" ],
            "else": [ "#else" ],
            "elseif": [ "#elseif" ],
            "endif": [ "#endif" ],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "preferNameDirectory": true,
  "forms": {
    "LastSegment": {
      "identifier": "replace",
      "pattern": "^(.*\\.)?",
      "replacement": ""
    },
    "DotToHyphen": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-"
    },
    "FullNameKebab": {
      "identifier": "chain",
      "steps": [
        "lowerCaseInvariant",
        "DotToHyphen"
      ]
    }
  },
  "symbols": {
    "ProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "LastSegment",
      "replaces": "MyProject",
      "fileRename": "MyProject"
    },
    "KebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "FullNameKebab",
      "replaces": "companyname-projectname"
    },
    "ServiceRole": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Identity",
      "description": "服务形态：Identity 自签发 OIDC 令牌并持有租户控制面；Standalone 只用 Cookie 会话（内部系统，不带授权服务器）；Resource 校验远端令牌、不持有认证凭据（但持有本系统授权主体）",
      "choices": [
        {
          "choice": "Identity",
          "description": "身份中心：OIDC 签发 + 本地用户 + 租户控制面"
        },
        {
          "choice": "Standalone",
          "description": "一体化应用：Cookie 会话 + 本地用户 + 租户控制面，不装 OpenIddict"
        },
        {
          "choice": "Resource",
          "description": "业务服务：校验远端令牌，不持有认证凭据；持有本系统的授权主体、角色与权限数据"
        }
      ]
    },
    "LocalIdentity": {
      "type": "computed",
      "value": "(ServiceRole != \"Resource\")"
    },
    "OpenIddictServer": {
      "type": "computed",
      "value": "(ServiceRole == \"Identity\")"
    },
    "RemoteTokenAuth": {
      "type": "computed",
      "value": "(ServiceRole == \"Resource\")"
    },
    "ServiceUserContextEnabled": {
      "type": "computed",
      "value": "(ServiceRole != \"Standalone\")"
    },
    "ExternalLogin": {
      "type": "computed",
      "value": "(LocalIdentity && IncludeExternalLogin)"
    },
    "IncludeNotifications": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含 SignalR 实时能力：通知中心（含历史与未读数）与业务事件推送",
      "defaultValue": "false"
    },
    "IncludeExternalLogin": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含外部登录（GitHub / Google 等第三方身份提供商）。仅在 ServiceRole=Identity|Standalone（有本地用户）下有效；Resource 形态下该开关无作用，相关文件由 !LocalIdentity 的排除清单剪掉",
      "defaultValue": "false"
    },
    "IncludeLocalization": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含多语言（i18n）支持：前端 Transloco 运行时切换 + 后端按 culture 本地化（默认语言英语）",
      "defaultValue": "false"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/.template.config/**",
        "**/artifacts/**",
        "frontend/node_modules/**",
        "frontend/node_modules*/**",
        "frontend/.angular/**",
        "frontend/.tmp/**",
        "frontend/dist/**",
        "test-scenarios/**",
        ".pid"
      ],
      "modifiers": [
        {
          "condition": "IncludeLocalization",
          "exclude": [
            "frontend/package.json",
            "frontend/package-lock.json"
          ]
        },
        {
          "condition": "!LocalIdentity",
          "exclude": [
            "frontend/src/app/features/settings/email-test/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/Migrations/Identity/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/Migrations/Control/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/IdentityControlDbContext.cs",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/DesignTime/IdentityControlDbContextFactory.cs",
            "backend/src/CompanyName.ProjectName.Api/Controllers/AuthController.cs",
            "backend/src/CompanyName.ProjectName.Api/Controllers/ExternalAuthController.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/**",
            "backend/src/CompanyName.ProjectName.Domain/Auth/**",
            "backend/src/CompanyName.ProjectName.Domain/Users/Options/UserRegistrationOptions.cs",
            "backend/src/CompanyName.ProjectName.Infrastructure/Auth/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/EntityConfigurations/IdentityEntityConfiguration.cs",
            "backend/src/CompanyName.ProjectName.Infrastructure/TenantConnections/PostgresTenantDatabaseErrorDescriber.cs",
            "backend/tests/CompanyName.ProjectName.UnitTests/Infrastructure/**",
            "backend/src/CompanyName.ProjectName.Client/Dtos/WhoAmIDto.cs",
            "frontend/src/app/shared/dtos/auth.dto.ts",
            "frontend/src/app/features/account/**",
            "frontend/src/app/features/platform/components/users/widgets/reset-user-password-dialog/**",
            "frontend/src/app/features/platform/components/users/widgets/user-edit-dialog/**",
            "frontend/src/app/core/guards/super-admin-guard.ts",
            "frontend/_mock/api/auth.ts",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/AuthorizationAndAuditingTests.cs",
            "backend/src/CompanyName.ProjectName.Application/Tenants/**",
            "backend/src/CompanyName.ProjectName.Application/TenantConnections/**",
            "backend/src/CompanyName.ProjectName.Api/Controllers/TenantController.cs",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/TenancyTests.cs",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/SettingsContractTests.cs",
            "frontend/src/app/features/platform/components/tenants/**",
            "frontend/src/app/features/platform/services/tenant-service.ts",
            "frontend/src/app/features/platform/services/tenant-connection-service.ts",
            "frontend/src/app/shared/dtos/tenant-connection.dto.ts",
            "frontend/_mock/api/tenant.ts",
            "frontend/_mock/api/tenant.spec.ts",
            "frontend/_mock/data/tenant.ts",
            "frontend/src/app/features/platform/components/tenants/tenants.spec.ts",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/SecureDefaultsTests.cs",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/VerificationCodeDigestTests.cs"
          ]
        },
        {
          "condition": "!IncludeNotifications",
          "exclude": [
            "backend/src/CompanyName.ProjectName.Api/Notifications/**",
            "backend/src/CompanyName.ProjectName.Application/Notifications/**",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/NotificationsAndRealTimeTests.cs",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/NotificationPreferencesTests.cs",
            "frontend/src/app/core/services/signalr-service.ts",
            "frontend/src/app/core/services/signalr-service.spec.ts",
            "frontend/src/app/layout/components/notifications/**",
            "frontend/_mock/api/notification.ts",
            "frontend/_mock/data/notifications.ts"
          ]
        },
        {
          "condition": "!ExternalLogin",
          "exclude": [
            "backend/src/CompanyName.ProjectName.Api/Controllers/ExternalAuthController.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/AppServices/ExternalAuthAppService.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/AppServices/IExternalAuthAppService.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/Dtos/ExternalLoginCallbackInputDto.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/Dtos/ExternalLoginUrlOutputDto.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/Dtos/ExternalLoginLinkDtos.cs",
            "backend/src/CompanyName.ProjectName.Domain/Auth/DomainServices/ExternalAuthDomainService.cs",
            "backend/src/CompanyName.ProjectName.Domain/Auth/Errors/ExternalAuthErrorCodes.cs",
            "backend/src/CompanyName.ProjectName.Domain/Auth/Entities/ExternalLoginConnection.cs",
            "backend/src/CompanyName.ProjectName.Domain/Auth/Abstractions/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Auth/**",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/ExternalAuthenticationTests.cs",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/ExternalLoginLinkTests.cs",
            "backend/tests/CompanyName.ProjectName.UnitTests/Infrastructure/ExternalAuthOptionsValidatorTests.cs",
            "frontend/src/app/features/account/components/external-auth-callback/**",
            "frontend/src/app/features/account/components/external-logins/**"
          ]
        },
        {
          "condition": "LocalIdentity",
          "exclude": [
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/Migrations/Resource/**",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/ResourceReadinessGateTests.cs"
          ]
        },
        {
          "condition": "!IncludeLocalization",
          "exclude": [
            "backend/src/CompanyName.ProjectName.Api/Resources/**",
            "frontend/public/i18n/**",
            "frontend/src/app/core/i18n/**",
            "frontend/src/app/core/services/language-service.ts",
            "frontend/src/app/core/interceptors/accept-language-interceptor.ts",
            "frontend/src/app/shared/components/language-switcher/**"
          ]
        },
        {
          "condition": "!IncludeLocalization || !LocalIdentity",
          "exclude": [
            "backend/tests/CompanyName.ProjectName.IntegrationTests/LocalizationTests.cs"
          ]
        },
        {
          "condition": "!OpenIddictServer",
          "exclude": [
            "backend/src/CompanyName.ProjectName.Api/Controllers/ConnectController.cs",
            "backend/src/CompanyName.ProjectName.Api/Controllers/OpenApplicationController.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/SignIn/AuthPrincipalFactory.cs",
            "backend/src/CompanyName.ProjectName.Application/Auth/SignIn/IAuthPrincipalFactory.cs",
            "backend/src/CompanyName.ProjectName.Application/OpenApplications/**",
            "backend/src/CompanyName.ProjectName.Domain/Auth/Options/OAuthOptions.cs",
            "frontend/src/app/features/platform/components/open-applications/**",
            "frontend/src/app/features/platform/services/open-application-service.ts",
            "frontend/src/app/features/platform/models/open-application.dto.ts",
            "frontend/_mock/api/open-application.ts",
            "frontend/_mock/data/open-applications.ts",
            "backend/tests/CompanyName.ProjectName.IntegrationTests/ServiceInvocationTests.cs",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/OpenIddictDbContext.cs",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/Migrations/OpenIddict/**",
            "backend/src/CompanyName.ProjectName.Infrastructure/Persistence/DesignTime/OpenIddictDbContextFactory.cs"
          ]
        }
      ]
    },
    {
      "condition": "IncludeLocalization",
      "source": "./.template.config/localization/frontend",
      "target": "./frontend"
    }
  ]
}
